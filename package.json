    "cubism-web-batched-renderer": "github:FMsongX2/cubism-web-batched-renderer",
    "modern-screenshot": "^4.7.0",
    "onnxruntime-web": "^1.30.0",
    "pinia": "^3.0.0",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "^6.5.10",
    "vue": "^3.5.0",
    "wlipsync": "^1.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "sharp": "^0.34.0",
    "smol-toml": "^1.4.0",
