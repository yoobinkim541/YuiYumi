{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YuiYumi",
  "version": "0.1.1",
  "identifier": "app.yuiyumi.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite --mode desktop --port 5181 --strictPort",
    "devUrl": "http://localhost:5181",
    "beforeBuildCommand": "pnpm vite build --mode desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Live2D desktop companion assistant",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  }
}
