{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/anthropic/**/*.ts": { "maxDuration": 300 },
    "api/**/*.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/anthropic/(.*)", "destination": "/api/anthropic/proxy" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
